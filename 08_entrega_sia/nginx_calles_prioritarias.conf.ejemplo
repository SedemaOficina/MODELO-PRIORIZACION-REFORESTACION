# }

# 2-ter) Pantalla de acceso y panel de administración: archivos estáticos, SIN auth_request (si no, nadie podría entrar).
#        /RUTA/DEL/VOLUMEN/acceso-calles es la carpeta login/acceso del paquete.
# location ^~ /acceso/calles/ {
#     alias /RUTA/DEL/VOLUMEN/acceso-calles/;
#     index index.html;
#     absolute_redirect off;
#     add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
#     add_header X-Content-Type-Options "nosniff" always;
#     add_header Referrer-Policy "same-origin" always;
#     add_header Cache-Control "no-cache" always;
# }

# 2-cuater) La API del módulo (/api/calles/) va al backend como las demás rutas /api/ del sitio. Si /api/ ya está enrutado,
#           no hace falta nada más. Debe llegar la IP real de la persona (X-Forwarded-For; con ADIP delante, configurar
#           set_real_ip_from para la capa intermedia) y el backend debe tener app.set('trust proxy', ...).
