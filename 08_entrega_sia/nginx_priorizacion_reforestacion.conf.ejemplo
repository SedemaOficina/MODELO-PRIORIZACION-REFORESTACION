# =====================================================================================================================
# Modelo de priorización de reforestación urbana · configuración de ejemplo para nginx (probada con la sintaxis de nginx 1.26)
# Sitio estático en la subruta /priorizacion-reforestacion/ del dominio del SIA, detrás del terminador de HTTPS.
#
# NO es un archivo para copiar tal cual: son dos fragmentos que el equipo del SIA integra en su configuración.
#   FRAGMENTO A  → dentro de http { }      (una sola vez)
#   FRAGMENTO B  → dentro del server { }   del dominio
# Sustituir /RUTA/DEL/VOLUMEN por la carpeta del volumen de datos donde viven los sitios estáticos.
# Esta configuración NO se validó con `nginx -t` en el equipo donde se escribió (no tenía nginx): validarla al integrarla.
# Lo que sí se probó, con un servidor de ensayo que envía estas mismas cabeceras (pruebas automáticas de la Oficina de la Secretaría).
# =====================================================================================================================

# ---------------------------------------------------------------------------------------------------------------------
# FRAGMENTO A · dentro de http { }
# ---------------------------------------------------------------------------------------------------------------------
# Caché: todo archivo pedido con huella (?v=…) no cambia nunca; lo demás (index.html, sw.js) se revalida siempre.
# La PÁGINA se revalida siempre, traiga o no ?v=: en la dirección de la página, ?v= es la avenida consultada
# (…/priorizacion-reforestacion/?a=09&v=123), no una huella. Sin estas reglas, un enlace compartido de una avenida dejaría
# la página guardada un año en el navegador y no vería las actualizaciones.
# La clave es «ruta|valor de v»; la primera expresión que coincide, en este orden, decide.
map "$uri|$arg_v" $priorizacion_reforestacion_cache {
    "~/\|"             "no-cache";
    "~/index\.html\|"  "no-cache";
    "~/sw\.js\|"       "no-cache";
    "~\|$"             "no-cache";
    default            "public, max-age=31536000, immutable";
}

# ---------------------------------------------------------------------------------------------------------------------
# FRAGMENTO B · dentro del server { } del dominio
# ---------------------------------------------------------------------------------------------------------------------

# 1) La dirección sin barra final. El servidor recibe HTTP del terminador de HTTPS: con la redirección automática de nginx
#    la dirección saldría como http://… ; por eso se devuelve una ruta relativa.
location = /priorizacion-reforestacion {
    absolute_redirect off;
    return 301 /priorizacion-reforestacion/$is_args$args;
}

# 2) El sitio. /RUTA/DEL/VOLUMEN/priorizacion-reforestacion es un enlace simbólico a la versión vigente (ver INSTALACION.md).
#    ^~ impide que una regla general del servidor por extensión (p. ej. location ~* \.(js|css)$ { expires …; }) atienda
#    los archivos de la herramienta: sin ^~, esa regla ganaría y los serviría sin estas cabeceras.
location ^~ /priorizacion-reforestacion/ {
    root /RUTA/DEL/VOLUMEN;
    index index.html;
    try_files $uri $uri/ =404;
    absolute_redirect off;

    # Si el servidor aplica límite de velocidad (limit_req) en esta ruta: la página pide 14 archivos al abrir.
    # Un límite con ráfaga menor a 30 produce errores 503 intermitentes. Ajustar la ráfaga o exceptuar esta ruta.

    # --- cabeceras (se repiten en el bloque de los .bin: en nginx, un bloque con add_header no hereda los del bloque padre) ---
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data: blob: https://services.arcgisonline.com https://static-map-tiles-api.arcgis.com; connect-src 'self' https://services.arcgisonline.com https://static-map-tiles-api.arcgis.com; font-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # «Mi ubicación» usa el GPS del teléfono: si la política general del sitio niega la geolocalización, aquí debe permitirse.
    add_header Permissions-Policy "geolocation=(self)" always;
    add_header Cache-Control $priorizacion_reforestacion_cache always;

    # Compresión de texto (si no está ya activa de forma general). Los .bin NO deben estar en gzip_types.
    gzip on;
    gzip_types text/css application/javascript application/json text/plain;
    gzip_min_length 1024;

    # 3) Archivos de datos: ya vienen comprimidos por dentro. No recomprimir ni etiquetar como gzip.
    location ~ ^/priorizacion-reforestacion/datos/.+\.bin$ {
        root /RUTA/DEL/VOLUMEN;
        gzip off;
        types { }
        default_type application/octet-stream;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data: blob: https://services.arcgisonline.com https://static-map-tiles-api.arcgis.com; connect-src 'self' https://services.arcgisonline.com https://static-map-tiles-api.arcgis.com; font-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(self)" always;
        add_header Cache-Control $priorizacion_reforestacion_cache always;
    }

    # 4) Lo que no es parte del sitio no se sirve aunque alguien lo copie a la carpeta.
    location ~ /\. { return 404; }
}

# ---------------------------------------------------------------------------------------------------------------------
# FASE 2 CON INICIO DE SESIÓN (controla el acceso y registra los usos). Ver login/LEEME.md.
# Sustituye al bloque 2 cuando estén instalados el módulo «priorizacion-reforestacion» en el backend y la pantalla de acceso.
# Todo queda bajo /priorizacion-reforestacion/, porque la cookie de sesión lleva Path=/priorizacion-reforestacion/:
#   /priorizacion-reforestacion/          la herramienta, con auth_request                                  (2-bis)
#   /priorizacion-reforestacion/acceso/   pantalla de acceso, panel de administración y aviso de privacidad,
#                                         SIN auth_request                                                  (2-ter)
#   /priorizacion-reforestacion/api/      el módulo del backend, SIN auth_request: él mismo revisa la sesión (2-cuater)
# nginx elige el prefijo más largo, así que 2-ter y 2-cuater ganan a 2-bis aunque empiecen igual; con ^~, tampoco
# las atiende una regla general del servidor por expresión regular.
# ---------------------------------------------------------------------------------------------------------------------
# 2-bis) La herramienta, protegida: cada archivo se entrega solo con sesión válida.
# location ^~ /priorizacion-reforestacion/ {
#     root /RUTA/DEL/VOLUMEN;
#     index index.html;
#     try_files $uri $uri/ =404;
#     absolute_redirect off;
#     auth_request /_priorizacion_reforestacion_sesion;                 # el backend responde 204 con sesión válida y 401 sin ella
#     # (las mismas cabeceras de seguridad y caché del bloque 2, y el bloque de los .bin)

#     # Solo la PÁGINA lleva a la pantalla de acceso. Datos y programas responden 401: así la herramienta
#     # puede decir «Tu sesión terminó» en lugar de «revisa tu conexión».
#     location = /priorizacion-reforestacion/ {
#         root /RUTA/DEL/VOLUMEN;
#         auth_request /_priorizacion_reforestacion_sesion;
#         error_page 401 = @priorizacion_reforestacion_acceso;
#         try_files /priorizacion-reforestacion/index.html =404;
#     }
# }
# Consulta de sesión (interna): nginx le pasa la cookie y la dirección pedida; el backend anota una visita si es la página.
# location = /_priorizacion_reforestacion_sesion {
#     internal;
#     proxy_pass http://SERVIDOR_DE_APLICACIONES:3000/api/priorizacion-reforestacion/sesion;
#     proxy_pass_request_body off;
#     proxy_set_header Content-Length "";
#     proxy_set_header X-Original-URI $request_uri;
#     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# }
# location @priorizacion_reforestacion_acceso {
#     absolute_redirect off;
#     return 302 /priorizacion-reforestacion/acceso/?volver=$request_uri;   # la pantalla de acceso toma todo lo que sigue a «volver=», aunque lleve «&»
# }

# 2-ter) Pantalla de acceso, panel de administración y aviso de privacidad: archivos estáticos, SIN auth_request
#        (si no, nadie podría entrar). /RUTA/DEL/VOLUMEN/acceso-priorizacion-reforestacion es la carpeta login/acceso del paquete.
# location = /priorizacion-reforestacion/acceso {
#     absolute_redirect off;
#     return 301 /priorizacion-reforestacion/acceso/$is_args$args;
# }
# location ^~ /priorizacion-reforestacion/acceso/ {
#     alias /RUTA/DEL/VOLUMEN/acceso-priorizacion-reforestacion/;
#     index index.html;
#     absolute_redirect off;                                             # …/acceso/admin redirige a …/acceso/admin/ con ruta relativa
#     add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
#     add_header X-Content-Type-Options "nosniff" always;
#     add_header Referrer-Policy "same-origin" always;
#     add_header Cache-Control "no-cache" always;
# }

# 2-cuater) La API del módulo. En sia-backend el módulo sigue montado en /api/priorizacion-reforestacion (src/index.ts):
#           nginx traduce la ruta pública a esa. SIN auth_request: el módulo responde 401 por sí mismo.
#           La IP de cada petición la calcula ipDeOrigen(req) de src/comun/procedencia.ts de sia-backend a partir de
#           X-Forwarded-For, descartando los saltos conocidos (proxy de ADIP y este nginx). No hace falta trust proxy.
# location ^~ /priorizacion-reforestacion/api/ {
#     proxy_pass http://SERVIDOR_DE_APLICACIONES:3000/api/priorizacion-reforestacion/;
#     proxy_set_header Host $host;
#     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#     proxy_set_header X-Forwarded-Proto $scheme;
#     client_max_body_size 1m;                                           # el módulo acepta hasta 100 KB por petición (alta masiva)
#     proxy_connect_timeout 5s;
#     proxy_read_timeout 60s;                                            # un envío del alta masiva (50 cuentas) tarda unos segundos
#     absolute_redirect off;
# }
# Opcional, si el SIA aplica su zona de límite «auth» al inicio de sesión (POST /priorizacion-reforestacion/api/entrar).
# El módulo ya limita los intentos fallidos por IP y detiene la cuenta tras 5. limit_req cuenta todas las peticiones.
